# ==============================================================================
# LedgerPro ATS — Environment Variables
# Copy this file to `.env` and fill in your credentials.
# ==============================================================================

# 1. Database (Supabase PostgreSQL Connection String - Session Pooler port 5432 recommended)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Supabase Storage (Optional: For 5MB Resume File Uploads to Supabase Bucket)
# If omitted, resume uploads automatically fall back to local/inline storage so everything works out-of-the-box.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="resumes"

# 3. Email Notifications via Resend (Optional)
# If omitted, email notifications automatically run in Mock Mode (logged to server & previewed in UI toast).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="LedgerPro Recruiting <onboarding@resend.dev>"
